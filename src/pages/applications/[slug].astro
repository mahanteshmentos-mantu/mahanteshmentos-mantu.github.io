---
import Base from '../../layouts/Base.astro';import PageHeader from '../../components/PageHeader.astro';import {applications} from '../../data/content';
export function getStaticPaths(){return applications.map(project => ({params:{slug:project.slug},props:{project}}));}
const {project}=Astro.props;
---
<Base title={project.title} description={project.summary}><PageHeader eyebrow={`Innovation lab / ${project.status}`} title={project.title} intro={project.summary} /><section class="section wrap detail-grid"><article class="prose"><h2>Project overview</h2>{project.body.map(p => <p>{p}</p>)}{project.screenshot && <figure><img src={project.screenshot.src} alt={project.screenshot.alt} width={project.screenshot.width} height={project.screenshot.height} loading="lazy" /></figure>}<aside class="editorial-note"><h2 class="h3">Status &amp; limitations</h2><p>{project.limitations}</p></aside></article><aside class="detail-aside"><p class="small-label">Project details</p><dl><dt>Status</dt><dd>{project.status}</dd><dt>Technology</dt><dd>{project.technology.join(' · ')}</dd></dl><div class="stack-links">{project.source && <a class="text-link" href={project.source}>View source on GitHub ↗</a>}{project.live && <a class="text-link" href={project.live}>Open application ↗</a>}{project.documentation && <a class="text-link" href={project.documentation}>Documentation ↗</a>}<a href="/applications/">← All applications</a></div></aside></section></Base>
