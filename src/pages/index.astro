---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { applications, research, resources } from '../data/content';
import { interests } from '../data/site';
---
<Base title="Physician · Research · Digital Health">
  <section class="hero wrap">
    <div class="hero-copy"><p class="eyebrow">Physician · Clinical pharmacology</p><h1>Dr Mahantesh<br /><em>Bhairumali.</em></h1><p class="hero-statement">Medicine, explored through<br class="desktop-break" /> research, education &amp; technology.</p><p class="hero-description">A professional home for my medical interests, scholarly work, teaching resources, and digital health projects.</p><div class="actions"><a class="button" href="/research/">Explore research <span aria-hidden="true">↗</span></a><a class="text-link" href="/about/">About me <span aria-hidden="true">→</span></a></div></div>
    <aside class="focus-panel" aria-label="Areas of focus"><div class="panel-top"><span class="small-label">An interdisciplinary perspective</span><span aria-hidden="true">MB / 01</span></div><div class="panel-center"><span class="panel-kicker">From questions</span><span class="panel-word">to understanding.</span><div class="editorial-lines" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div></div><div class="panel-bottom"><span>Clinical pharmacology<br />Medical research</span><span>Education<br />Digital health</span></div></aside>
  </section>
  <section class="section wrap"><div class="section-heading"><div><p class="eyebrow">A connected practice</p><h2>Four areas. One perspective.</h2></div><p>Exploring how medical knowledge is developed, communicated, and put to use.</p></div><div class="interest-grid">{interests.map(i => <article><span class="index-number">{i.number}</span><h3>{i.title}</h3><p>{i.text}</p></article>)}</div></section>
  <section class="section tinted"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">Innovation lab</p><h2>Ideas taking shape.</h2></div><a class="text-link" href="/applications/">All applications <span aria-hidden="true">↗</span></a></div>{applications.slice(0,1).map(project => <ProjectCard project={project} />)}</div></section>
  <section class="section wrap two-col"><div><p class="eyebrow">Research</p><h2>A space for evidence<br />and inquiry.</h2><p>Publications, studies, and scholarly contributions, with clear status and links to their original sources.</p>{research.length ? research.slice(0,2).map(r => <p><a href={`/research/${r.slug}/`}>{r.title}</a></p>) : <p class="collection-note">The publication collection is awaiting verified records.</p>}<a class="text-link" href="/research/">Visit research <span aria-hidden="true">→</span></a></div><div><p class="eyebrow">Education</p><h2>Knowledge made<br />more approachable.</h2><p>A dedicated home for pharmacology learning, research methodology, and medical teaching materials.</p>{resources.length ? resources.slice(0,2).map(r => <p><a href={`/education/${r.slug}/`}>{r.title}</a></p>) : <p class="collection-note">Teaching materials will appear as they become available.</p>}<a class="text-link" href="/education/">Explore education <span aria-hidden="true">→</span></a></div></section>
  <section class="closing wrap"><p class="eyebrow">Connect</p><h2>A conversation can be<br />the beginning of an idea.</h2><a class="button" href="/contact/">Professional connections <span aria-hidden="true">↗</span></a></section>
</Base>
