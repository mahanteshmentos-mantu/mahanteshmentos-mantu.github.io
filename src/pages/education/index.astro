---
import Base from '../../layouts/Base.astro';import PageHeader from '../../components/PageHeader.astro';import EmptyState from '../../components/EmptyState.astro';import {resources} from '../../data/content';
const topics=['Clinical pharmacology','Research methodology','Medical education'];
---
<Base title="Education" description="Pharmacology, research methodology, and medical education resources from Dr Mahantesh Bhairumali."><PageHeader eyebrow="Education / Learning & teaching" title="Making room for understanding." intro="Teaching materials and learning resources for exploring pharmacology, medical research, and the questions that connect them." /><section class="section wrap"><div class="interest-grid three">{topics.map((t,i)=><article><span class="index-number">0{i+1}</span><h2 class="h3">{t}</h2></article>)}</div></section><section class="section wrap"><div class="section-heading"><h2>Resource library</h2><span class="small-label">Guides · Slides · Worksheets · Reading</span></div>{resources.length ? <div class="record-list">{resources.map(r=><article><span class="small-label">{r.topic} / {r.kind}</span><h3><a href={`/education/${r.slug}/`}>{r.title}</a></h3><p>{r.summary}</p></article>)}</div> : <EmptyState title="Materials are not available yet." text="Teaching resources will be listed here when reviewed files and source links are available. There are currently no downloads in this collection." />}<p class="collection-note">For education and professional learning. These materials do not replace individual medical assessment or clinical judgment.</p></section></Base>
