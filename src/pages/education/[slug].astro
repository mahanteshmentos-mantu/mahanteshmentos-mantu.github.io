---
import Base from '../../layouts/Base.astro';import PageHeader from '../../components/PageHeader.astro';import {resources} from '../../data/content';
export function getStaticPaths(){return resources.map(record=>({params:{slug:record.slug},props:{record}}));}
const {record}=Astro.props;
---
<Base title={record.title} description={record.summary}><PageHeader eyebrow={`${record.topic} / ${record.kind}`} title={record.title} intro={record.summary} /><section class="section wrap prose">{record.body.map(p=><p>{p}</p>)}<div class="stack-links">{record.url && <a href={record.url}>View original resource ↗</a>}{record.download && <a href={record.download} download>Download {record.kind.toLowerCase()}</a>}<a href="/education/">← All resources</a></div><p class="collection-note">Educational material, not individual medical advice.</p></section></Base>
