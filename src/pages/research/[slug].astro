---
import Base from '../../layouts/Base.astro';import PageHeader from '../../components/PageHeader.astro';import {research} from '../../data/content';
export function getStaticPaths(){return research.map(record=>({params:{slug:record.slug},props:{record}}));}
const {record}=Astro.props;
---
<Base title={record.title} description={record.summary}><PageHeader eyebrow={`${record.kind} / ${record.status}`} title={record.title} intro={record.summary} /><section class="section wrap prose"><p>{record.authors?.join(', ')}{record.year && ` · ${record.year}`}{record.journal && ` · ${record.journal}`}</p>{record.body.map(p=><p>{p}</p>)}<div class="stack-links">{record.doi && <a href={`https://doi.org/${record.doi}`}>DOI: {record.doi}</a>}{record.url && <a href={record.url}>Original source ↗</a>}{record.download && <a href={record.download} download>Download {record.kind.toLowerCase()}</a>}<a href="/research/">← All research</a></div></section></Base>
