---
import Base from '../../layouts/Base.astro';import PageHeader from '../../components/PageHeader.astro';import EmptyState from '../../components/EmptyState.astro';import { research } from '../../data/content';
---
<Base title="Research" description="Research interests and a growing collection of publications, studies, posters, and presentations from Dr Mahantesh Bhairumali."><PageHeader eyebrow="Research / Evidence & inquiry" title="Questions worth pursuing." intro="A home for medical research, scholarly contributions, and the methods behind them." /><section class="section wrap two-col"><div><p class="eyebrow">Research interests</p><h2>Clinical pharmacology<br />&amp; medical research.</h2><p>This collection is designed to keep research traceable: each entry identifies its type, current status, and available original source.</p></div><aside class="editorial-note"><h2 class="h3">Reading the record</h2><p>Published work, preprints, submitted manuscripts, and ongoing studies are labeled separately. A submission is not a publication; a preprint has not necessarily undergone peer review.</p></aside></section><section class="section wrap"><div class="section-heading"><h2>Scholarly work</h2><span class="small-label">Publications · Studies · Presentations</span></div>{research.length ? <div class="record-list">{research.map(r => <article><span class="small-label">{r.kind} / {r.status}</span><h3><a href={`/research/${r.slug}/`}>{r.title}</a></h3><p>{r.summary}</p></article>)}</div> : <EmptyState title="No research records listed yet." text="Verified publications, project summaries, posters, and presentations will be added to this collection. No publication history is implied by this empty listing." />}</section></Base>
