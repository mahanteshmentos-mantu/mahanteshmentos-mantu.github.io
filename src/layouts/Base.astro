---
import '../styles/global.css';
import { identity, navigation } from '../data/site';
interface Props { title: string; description?: string; noindex?: boolean; }
const { title, description = identity.description, noindex = false } = Astro.props;
const pathname = Astro.url.pathname;
const canonical = new URL(noindex ? "/404.html" : pathname, identity.url);
const schema = { '@context': 'https://schema.org', '@type': 'Person', name: identity.name, url: identity.url, jobTitle: 'Physician', sameAs: [identity.github] };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {identity.name}</title><meta name="description" content={description} />
    <link rel="canonical" href={canonical} /><link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="color-scheme" content="light dark" /><meta name="theme-color" content="#164f49" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" /><meta property="og:site_name" content={identity.name} />
    <meta property="og:title" content={`${title} | ${identity.name}`} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\u003c')} />
    <script is:inline>
      try { const t = localStorage.getItem('mb-theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="brand" href="/" aria-label="Dr Mahantesh Bhairumali — Home"><span class="monogram" aria-hidden="true">mb.</span><span>Mahantesh<br /><strong>Bhairumali</strong></span></a>
      <nav aria-label="Primary navigation">{navigation.map(item => <a href={item.href} aria-current={(item.href === '/' ? pathname === '/' : pathname.startsWith(item.href)) ? 'page' : undefined}>{item.label}</a>)}</nav>
      <button class="theme-toggle" id="theme-toggle" hidden aria-label="Change color theme">Theme</button>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer wrap">
      <div class="footer-top"><div><a class="footer-name" href="/">Dr Mahantesh Bhairumali</a><p>Medicine. Inquiry. Education. Innovation.</p></div><a class="text-link" href="/contact/">Professional connections <span aria-hidden="true">↗</span></a></div>
      <nav aria-label="Footer navigation">{navigation.filter(i => i.href !== '/').map(item => <a href={item.href}>{item.label}</a>)}</nav>
      <div class="fine-print"><p>© {new Date().getFullYear()} Dr Mahantesh Bhairumali</p><p>Educational information, not individual medical advice.</p><a href="/privacy/">Privacy</a></div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
      const preference = window.matchMedia('(prefers-color-scheme: dark)');
      function currentTheme() { return document.documentElement.dataset.theme || (preference.matches ? 'dark' : 'light'); }
      function updateLabel() { if (toggle) { const next = currentTheme() === 'dark' ? 'light' : 'dark'; toggle.textContent = next === 'light' ? 'Light mode' : 'Dark mode'; toggle.setAttribute('aria-label', `Switch to ${next} theme`); } }
      if (toggle) { toggle.hidden = false; updateLabel(); toggle.addEventListener('click', () => { const next = currentTheme() === 'dark' ? 'light' : 'dark'; document.documentElement.dataset.theme = next; try { localStorage.setItem('mb-theme', next); } catch {} updateLabel(); }); preference.addEventListener('change', updateLabel); }
    </script>
  </body>
</html>
